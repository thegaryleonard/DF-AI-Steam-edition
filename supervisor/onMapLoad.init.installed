# This file runs when a map is loaded in adventure or fort mode, after any
# onLoad.init files (which run earlier, when the world is loaded).
#
# You can extend or override DFHack's default configuration by adding commands
# to this file.

# df-ai stream mode: spectate camera with labels, resumed when nobody is playing
dfai-site-reset
enable spectate
dfai-spectate-keeper start
dfai-follow-label-only
dfai-fps apply
overlay enable dfai-room-tour.label
dfai-room-tour start
spectate set tooltip-follow false
overlay enable dfai-portrait-builder.builder
dfai-foreign-office start
dfai-war-office start
dfai-deep-dig start
dfai-holiday resume
dfai-ore-scrub resume
dfai-battle-report start
dfai-ascii start
dfai-catacomb resume
dfai-build resume
dfai-cavern-ore resume
autolabor BUTCHER 4 8
dfai-camera-lock start
dfai-instruments start
dfai-archer-posts start

dfai-cavern-seal start
dfai-armory start
autolabor MASON 6 12
# mechanisms: cage traps, wells, levers, the bunkers (2 mechanics for 183 dwarves left 141 traps waiting)
autolabor MECHANIC 3 10
dfai-fort-health start
dfai-bunker start
dfai-mist start
dfai-walls start
dfai-traffic start
dfai-ghost-watch start
dfai-pit start
dfai-wellshaft start
dfai-yardwatch start
dfai-toollabor start
# second line of defence: the cistern's two floodgates never stand open together with water behind the inlet
dfai-floodguard start
# pings the owner when a bolt thrower kills something
dfai-turretwatch start
dfai-watchdog start
dfai-verify start
dfai-fps start
